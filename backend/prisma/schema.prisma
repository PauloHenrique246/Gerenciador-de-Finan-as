generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model aluno {
  id              Int               @id @default(autoincrement())
  nome            String
  telefone        String
  cursoId         Int
  curso           curso             @relation(fields: [cursoId], references: [id], map: "Aluno_cursoId_fkey")
  planofinanceiro planofinanceiro[]

  @@index([cursoId], map: "Aluno_cursoId_fkey")
}

model curso {
  id         Int              @id @default(autoincrement())
  nome       String
  modalidade curso_modalidade
  aluno      aluno[]
}

model parcelas {
  id                Int             @id @default(autoincrement())
  dataVencimento    DateTime
  dataPagamento     DateTime?
  valor             Decimal
  descontosOuJuros  Decimal         @default(0.000000000000000000000000000000)
  cancelada         Boolean         @default(false)
  planoFinanceiroId Int
  planofinanceiro   planofinanceiro @relation(fields: [planoFinanceiroId], references: [id], map: "Parcelas_planoFinanceiroId_fkey")

  @@index([planoFinanceiroId], map: "Parcelas_planoFinanceiroId_fkey")
}

model planofinanceiro {
  id                 Int                       @id @default(autoincrement())
  quantidadeParcelas Int
  alunoId            Int
  categoria          planofinanceiro_categoria
  parcelas           parcelas[]
  aluno              aluno                     @relation(fields: [alunoId], references: [id], map: "PlanoFinanceiro_alunoId_fkey")

  @@index([alunoId], map: "PlanoFinanceiro_alunoId_fkey")
}

model user {
  id            Int    @id @default(autoincrement())
  name          String
  email         String @unique(map: "User_email_key")
  password_hash String
}

enum curso_modalidade {
  REGULAR
  DIGITAL
}

enum planofinanceiro_categoria {
  PARCELA
  MATRICULA
}
